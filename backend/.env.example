# ---------------------------------------------------------------------------
# Django backend environment variables
# Copy to backend/.env for local development. Do not commit real secrets.
# ---------------------------------------------------------------------------

# Django cryptographic signing key. Generate a strong random value for production.
SECRET_KEY=django-insecure-change-me

# Use True for local development and False in production.
DEBUG=True

# PostgreSQL connection string (dj-database-url format).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ethical_ai

# Comma-separated hosts Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origin of the Next.js frontend.
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated HTTPS origins trusted for CSRF in production, if needed.
CSRF_TRUSTED_ORIGINS=

# Optional: use SQLite only for the automated test suite.
USE_SQLITE_FOR_TESTS=False

# Optional: admin bootstrap consumed by `python manage.py create_admin`.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=
